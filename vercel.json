{
  "version": 2,
  "builds": [
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "env": {
    "SUPABASE_URL": "YOUR_SUPABASE_URL_HERE",
    "SUPABASE_ANON_KEY": "YOUR_SUPABASE_ANON_KEY_HERE"
  }
}
